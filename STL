## 🔹 5. DEQUE
----------------------------------------
deque<int> dq;

dq.push_back(10);
dq.push_front(5);

dq.pop_back();
dq.pop_front();

cout << dq.front();
cout << dq.back();

sort(dq.begin(), dq.end());
reverse(dq.begin(), dq.end());

