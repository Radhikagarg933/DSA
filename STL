========================================
# C++ STL OPERATIONS WITH EXAMPLES
========================================

---

## 🔹 1. VECTOR
----------------------------------------
Declaration:
vector<int> v;

Add element:
v.push_back(10);
v.push_back(20);

Remove last:
v.pop_back();

Access:
cout << v[0];

Front / Back:
cout << v.front();
cout << v.back();

Size:
cout << v.size();

Insert:
v.insert(v.begin() + 1, 100);

Erase:
v.erase(v.begin() + 1);

Sort:
sort(v.begin(), v.end());
sort(v.rbegin(), v.rend()); //descending order
(is_sorted(v.begin(), v.end())// check if sorted or not

Reverse:
reverse(v.begin(), v.end());

Example:
vector<int> v = {1,2,3};
v.push_back(4);   // {1,2,3,4}
v.pop_back();     // {1,2,3}

---

## 🔹 2. STRING
----------------------------------------
Declaration:
string s = "hello";

Length:
cout << s.size();

Add char:
s.push_back('!');

Substring:
cout << s.substr(1,3);

Find:
cout << s.find("ll");

Reverse:
reverse(s.begin(), s.end());

Sort:
sort(s.begin(), s.end());

Example:
string s = "abc";
s += "def";

---

